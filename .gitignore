# ไฟล์นี้ถูกสลับเป็น `.gitignore` ที่รากของ repo สาธารณะตอน export
# ⛔ ตั้งชื่อไม่มีจุดนำหน้าโดยตั้งใจ — ถ้าตั้งเป็น `.gitignore` ในรีโปนี้
#    มันจะไปมีผลกับรีโปของทีมด้วย ซึ่งไม่ใช่สิ่งที่ต้องการ

# dependencies
/node_modules
/.pnp
.pnp.*

# build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# testing
/coverage

# environment — ⛔ ห้าม commit ไฟล์ env ทุกกรณี
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
